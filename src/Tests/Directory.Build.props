<Project>

  <Import Project="../Directory.Build.props" />

  <PropertyGroup>
    <!-- Also test against latest .NET to ensure consistent behavior for the polyfill -->
    <TargetFrameworks>netcoreapp2.1;netcoreapp3.1;net5.0;net10.0</TargetFrameworks>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>

    <EnablePackageValidation>false</EnablePackageValidation>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.11.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net5.0' Or '$(TargetFramework)'=='netcoreapp3.1'">
    <PackageReference Update="NUnit3TestAdapter" Version="5.2.0" />
    <PackageReference Update="NUnit" Version="3.14" />
    <!-- https://github.com/microsoft/vstest/releases/tag/v17.14.0 -->
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="17.13.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='netcoreapp2.1'">
    <PackageReference Update="NUnit3TestAdapter" Version="4.3.0" />
    <PackageReference Update="NUnit" Version="3.14" />
    <!-- https://github.com/microsoft/vstest/releases/tag/v17.14.0 -->
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="17.13.0" />
  </ItemGroup>

  <PropertyGroup>
    <NoWarn>$(NoWarn);CS1591;NU1902;NU1903</NoWarn>
  </PropertyGroup>
</Project>
